# Required — powers all AI analysis. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required for the YouTube tab. Create a key at https://console.cloud.google.com
# (enable "YouTube Data API v3" for the project first)
YOUTUBE_API_KEY=AIza...

# Optional — for the Facebook tab. A Meta Graph API access token with
# permission to read the target Page's posts/comments.
FACEBOOK_ACCESS_TOKEN=

# --- Accounts (sign in / sign up) ---

# Required for accounts. Postgres connection string. On Vercel: Storage →
# Create Database → Neon Postgres → connect to this project (auto-added).
DATABASE_URL=

# Required for accounts. Any long random string. Generate one at
# https://generate-secret.vercel.app/32
AUTH_SECRET=

# Optional — enables the "Continue with Google" button. Create an OAuth
# client at https://console.cloud.google.com → APIs & Services → Credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
