# Required — powers all AI analysis. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required for the YouTube tab. Create a key at https://console.cloud.google.com
# (enable "YouTube Data API v3" for the project first)
YOUTUBE_API_KEY=AIza...

# Optional — for the Facebook tab. A Meta Graph API access token with
# permission to read the target Page's posts/comments.
FACEBOOK_ACCESS_TOKEN=
